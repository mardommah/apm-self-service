# ─── Database ─────────────────────────────────────────────────────────────────
# Variabel terpisah digunakan oleh Makefile (aman untuk password dengan karakter khusus)
DB_USER=root
DB_PASS=your_password_here
# Jika password mengandung karakter khusus, bungkus dengan single quotes:
# DB_PASS='p@ssw0rd#secret'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=klinik_selfservice

# DATABASE_URL untuk Drizzle ORM — karakter khusus di password harus di-URL-encode
# Contoh karakter yang perlu di-encode: @ → %40, # → %23, $ → %24, & → %26
DATABASE_URL=mysql://root:your_password_here@localhost:3306/klinik_selfservice

# ─── Database SIM RS (read-only) ────────────────────────────────────────────────
# Gunakan akun khusus dengan hak SELECT pada tabel booking/pasien SIM RS.
SIMRS_DB_HOST=localhost
SIMRS_DB_PORT=3306
SIMRS_DB_NAME=klinik_syamsinar
SIMRS_DB_USER=simrs_reader
SIMRS_DB_PASS=ganti-dengan-password-read-only

# ─── App ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-random-minimal-32-karakter
APP_URL=http://localhost:3000
KIOSK_TIMEOUT_MS=300000

# ─── mLITE BPJS bridge ───────────────────────────────────────────────────────
# Server-to-server only. Token is never sent to the browser.
MLITE_BASE_URL=https://mlite.example.com
MLITE_API_TOKEN=ganti-dengan-token-internal-mlite
MLITE_REQUEST_TIMEOUT_MS=15000
MLITE_GENERAL_PATIENT_URL=https://mlite.example.com/anjungan/pasien

# ─── BPJS FKTL check-in ───────────────────────────────────────────────
# Kredensial hanya dibaca server; tidak pernah dikirim ke browser kiosk.
BPJS_FKTL_BASE_URL=https://bpjs-fktl.example.com/api
BPJS_FKTL_USERNAME=ganti-dengan-username-api
BPJS_FKTL_PASSWORD=ganti-dengan-password-api
BPJS_FKTL_REQUEST_TIMEOUT_MS=15000

# ─── Frista local agent ───────────────────────────────────────────────────────
# URL is accessed by the Windows kiosk browser. Shared secret exists on this
# server and the local agent; it is used to sign short-lived jobs.
FRISTA_AGENT_URL=http://127.0.0.1:3001
FRISTA_AGENT_SHARED_SECRET=ganti-dengan-secret-agent-minimal-32-karakter
FRISTA_USERNAME=ganti-dengan-username-frista
FRISTA_PASSWORD=ganti-dengan-password-frista
